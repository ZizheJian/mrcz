\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Rate--distortion curves on Datasets\nobreakspace  {}1--6 for baseline-layout selection. Across the 17 fields included in the aggregate statistics, the average CR improvements are 51.6\% for FDWZ over the best baseline and 86.9\% for MRCZ over FDWZ. The selected baseline layouts are SZ3-4D, SZ2-3D-fused, QoZ-4D, ZFP-3D-fused, SPERR-2D, and MGARD-X-1D.\relax }}{10}\protected@file@percent }
\newlabel{fig:small-rate-distortion}{{11}{10}}
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces Rate--distortion comparison of FDWZ, MRCZ, and the selected baseline configurations on Datasets\nobreakspace  {}7 and\nobreakspace  {}8. Across the 10 fields, the average CR improvements are 77.6\% for FDWZ over the best baseline and 104.8\% for MRCZ over FDWZ.\relax }}{10}\protected@file@percent }
\newlabel{fig:large-rate-distortion}{{12}{10}}
\@writefile{toc}{\contentsline {subsection}{\numberline {\mbox  {VII-D}}End-to-End Workflow Evaluation}{10}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces Aggregate compression and decompression throughput on Datasets\nobreakspace  {}7 and\nobreakspace  {}8. The top row uses 8 CPU cores for Dataset\nobreakspace  {}7 and 16 for Dataset\nobreakspace  {}8. The bottom row uses 64 and 128 CPU cores, respectively. FDWZ ranks among the two fastest methods in 35 of the 40 cases and ranks first in 18 of the 20 lower-core-count cases.\relax }}{11}\protected@file@percent }
\newlabel{fig:throughput}{{13}{11}}
\@writefile{lof}{\contentsline {figure}{\numberline {14}{\ignorespaces End-to-end time at relative error bounds of $10^{-4}$ for Dataset\nobreakspace  {}7 and $10^{-6}$ for Dataset\nobreakspace  {}8, decomposed into compression, Globus transfer, and decompression time. The diagonally striped MGARD-X compression and decompression segments are ideal projections, while its transfer segments are measured. The fastest compressed workflows reduce end-to-end time by 79.2\% on Dataset\nobreakspace  {}7 and 88.3\% on Dataset\nobreakspace  {}8. FDWZ matches the fastest method on Dataset\nobreakspace  {}7 and is fastest on Dataset\nobreakspace  {}8.\relax }}{11}\protected@file@percent }
\newlabel{fig:transfer}{{14}{11}}
\@writefile{lof}{\contentsline {figure}{\numberline {15}{\ignorespaces Effective Globus transfer throughput versus compressed payload size. Circles and triangles denote Datasets\nobreakspace  {}7 and\nobreakspace  {}8, and each error bar spans the three transfer trials. Across the 14 compressed workflows, larger payloads attain higher effective throughput, partially offsetting the transfer-time benefit of stronger compression.\relax }}{11}\protected@file@percent }
\newlabel{fig:transfer-size-time}{{15}{11}}
